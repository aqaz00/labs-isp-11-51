<mxfile host="app.diagrams.net"><diagram id="to_be" name="Как стало (To Be): обработка результатов экзаменационной сессии"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Как стало (To Be): обработка результатов экзаменационной сессии" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="960" height="36" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. Преподаватель&lt;/b&gt;&lt;br&gt;Вносит оценки в электронную ведомость в личном кабинете" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="460" height="98" as="geometry"/></mxCell><mxCell id="n1" value="Единый ввод данных, без бумаги" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="79" width="330" height="80" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Система&lt;/b&gt;&lt;br&gt;Автоматически проверяет полноту и допустимость значений" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="460" height="98" as="geometry"/></mxCell><mxCell id="n2" value="Ошибки отсекаются при вводе (цель: не более 1%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="209" width="330" height="80" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Преподаватель&lt;/b&gt;&lt;br&gt;Подтверждает и закрывает ведомость под своей учётной записью" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="460" height="98" as="geometry"/></mxCell><mxCell id="n3" value="Фиксируются дата, время и пользователь" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="339" width="330" height="80" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Система&lt;/b&gt;&lt;br&gt;Автоматически формирует сводную ведомость по группе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="460" height="98" as="geometry"/></mxCell><mxCell id="n4" value="Не более 5 минут вместо 40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="469" width="330" height="80" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Заместитель декана&lt;/b&gt;&lt;br&gt;Проверяет и утверждает ведомость в системе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="460" height="98" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Система&lt;/b&gt;&lt;br&gt;Формирует проект приказа по шаблону и передаёт на согласование" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="460" height="98" as="geometry"/></mxCell><mxCell id="n6" value="Данные не дублируются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="729" width="330" height="80" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7. Студент&lt;/b&gt;&lt;br&gt;Видит результаты и задолженности в личном кабинете, получает уведомление" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="460" height="98" as="geometry"/></mxCell><mxCell id="n7" value="Доступ к результатам в день закрытия ведомости" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="859" width="330" height="80" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s2" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s3" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s4" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s6" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s7" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>