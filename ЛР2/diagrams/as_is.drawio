<mxfile host="app.diagrams.net"><diagram id="as_is" name="Как было (As Is): обработка результатов экзаменационной сессии"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Как было (As Is): обработка результатов экзаменационной сессии" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="960" height="36" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. Преподаватель&lt;/b&gt;&lt;br&gt;Принимает экзамен, оформляет бумажную ведомость" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="460" height="98" as="geometry"/></mxCell><mxCell id="n1" value="Бумага, помарки и исправления в ведомости" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="79" width="330" height="80" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Преподаватель&lt;/b&gt;&lt;br&gt;Лично относит ведомость в деканат" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="460" height="98" as="geometry"/></mxCell><mxCell id="n2" value="Задержка до 3 рабочих дней" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="209" width="330" height="80" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Диспетчер деканата&lt;/b&gt;&lt;br&gt;Вручную переносит оценки в Excel-таблицу группы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="460" height="98" as="geometry"/></mxCell><mxCell id="n3" value="Ошибки ручного ввода: около 8% ведомостей" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="339" width="330" height="80" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Диспетчер деканата&lt;/b&gt;&lt;br&gt;Сверяет данные, при расхождениях возвращается к преподавателю" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="460" height="98" as="geometry"/></mxCell><mxCell id="n4" value="Повторные обращения, потеря времени" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="469" width="330" height="80" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Диспетчер деканата&lt;/b&gt;&lt;br&gt;Вручную формирует сводную ведомость по группе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="460" height="98" as="geometry"/></mxCell><mxCell id="n5" value="Около 40 минут на одну группу" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="599" width="330" height="80" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Заместитель декана&lt;/b&gt;&lt;br&gt;Проверяет и подписывает бумажную сводную ведомость" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="460" height="98" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7. Диспетчер деканата&lt;/b&gt;&lt;br&gt;Готовит проект приказа (допуск, перевод, отчисление) в Word" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="460" height="98" as="geometry"/></mxCell><mxCell id="n7" value="Одни и те же данные в нескольких файлах" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="859" width="330" height="80" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8. Студент&lt;/b&gt;&lt;br&gt;Узнаёт результаты на стенде или у старосты" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="460" height="98" as="geometry"/></mxCell><mxCell id="n8" value="Нет оперативного доступа к своим данным" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="989" width="330" height="80" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s2" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s3" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s4" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s5" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s7" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="s8" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>